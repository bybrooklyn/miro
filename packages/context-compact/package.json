{
  "name": "@miro/context-compact",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@miro/model-client": "workspace:*",
    "@miro/model-catalog": "workspace:*",
    "@miro/native": "workspace:*",
    "@miro/agent-sys": "workspace:*",
